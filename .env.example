NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://bravy:bravy123@localhost:5432/chat_bullq

# JWT
JWT_SECRET=change-me-generate-with-node-e-require-crypto-randomBytes-64-toString-hex
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-generate-another-different-one
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGIN=http://localhost:3000

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=bravy
MINIO_SECRET_KEY=bravy123minio
MINIO_BUCKET=chat-bullq

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bravy.com

OPENAI_API_KEY=sk-proj-your-key-here

# Sakana LLM (Fugu / Fugu Ultra)
SAKANA_API_KEY=sk-sakana-your-key-here
SAKANA_BASE_URL=https://api.sakana.ai/v1
SAKANA_TIMEOUT_MS=120000

# Google OAuth App (canal GMAIL — um app pra todas as caixas; o
# refresh_token de cada caixa fica em Channel.config)
# Scopes: gmail.readonly + gmail.send + gmail.modify
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Poller do canal GMAIL (cron BullMQ)
GMAIL_POLL_PATTERN=*/1 * * * *
GMAIL_INITIAL_LOOKBACK_HOURS=24
# Teto de emails por caixa no backfill inicial (default 100)
GMAIL_INITIAL_BACKFILL_MAX=100

# Alertas operacionais por e-mail (Resend — https://resend.com/api-keys)
# Usado hoje só pelo ZappfyConnectionHealthCron (canal WhatsApp desconectado).
RESEND_API_KEY=
# Precisa de domínio verificado no Resend pra mandar de um remetente próprio;
# sem isso, o Resend só aceita enviar pro e-mail da própria conta cadastrada.
RESEND_FROM_EMAIL=Justine OS <onboarding@resend.dev>
# E-mail(s) que recebem o alerta quando o WhatsApp cai (separar por vírgula
# se for mais de um destinatário).
ZAPPFY_HEALTH_ALERT_EMAIL_TO=

# Checagem de saúde da conexão Zappfy (cron BullMQ) — default a cada 10 min.
ZAPPFY_HEALTH_CHECK_PATTERN=*/10 * * * *
# Intervalo mínimo (minutos) entre re-alertas pro mesmo canal enquanto
# continuar desconectado — evita spam de e-mail numa queda prolongada.
ZAPPFY_HEALTH_ALERT_COOLDOWN_MINUTES=60

# Ping interno via WhatsApp quando há handoff pra humano (equipe interna).
# Números com DDI+DDD, separados por vírgula, sem espaço, sem +/traço.
# Ex: 5551999999999,5554988888888
HANDOFF_ALERT_WHATSAPP_NUMBERS=

# Sync da planilha de controle de leads (Google Sheets via service account).
# Cole o conteúdo INTEIRO do JSON da service account numa linha só.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# ID da planilha (trecho da URL entre /d/ e /edit).
GOOGLE_SHEETS_SPREADSHEET_ID=
# Nome da aba (o sync CRIA sozinho se não existir; nunca toca em aba já
# existente com outro nome/propósito).
GOOGLE_SHEETS_TAB_NAME=Leads (Justine OS)
# A cada quanto tempo o sync roda.
LEADS_SHEET_SYNC_PATTERN=*/15 * * * *
